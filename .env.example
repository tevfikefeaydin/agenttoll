# Required: your nonzero public receiving wallet address (replace this placeholder).
ADDRESS=0xYourReceivingWalletAddress

# Payment network only: base-sepolia (default) or base (real mainnet USDC).
# Base market/onchain data always come from mainnet.
NETWORK=base-sepolia
PORT=4021

# Public origin used by discovery, the catalog and the agent card.
# HTTPS is required except for localhost; no credentials/query/fragment.
PUBLIC_URL=http://localhost:4021

# Default testnet facilitator. With NETWORK=base and this default URL,
# the server selects CDP and requires BOTH credentials below.
FACILITATOR_URL=https://x402.org/facilitator
# CDP_API_KEY_ID=your-key-id
# CDP_API_KEY_SECRET=your-secret

# End-to-end server deadline in milliseconds (100–120000; default 25000).
REQUEST_TIMEOUT_MS=25000

# Local default false; Vercel defaults to one trusted proxy hop when unset.
# Use false, 1–5 trusted hops, or comma-separated trusted IP/CIDR entries.
# Set this only for the proxy topology you control.
# TRUST_PROXY=false

# Optional upstream credential; do not commit a real key.
# BLOCKSCOUT_API_KEY=proapi_...

# Paying Node examples/scripts and MCP. Leave AGENT_PRIVATE_KEY unset for
# MCP quote-only mode. Hosted requests use real Base mainnet USDC.
# AGENT_PRIVATE_KEY=0x...

# Examples default to http://localhost:4021; MCP/paid scripts default hosted.
# AGENTTOLL_URL=http://localhost:4021
# AGENTTOLL_NETWORK=base-sepolia
# Explicit expected public receiver is REQUIRED for custom hosts in MCP.
# Examples/scripts may reuse ADDRESS only when AGENTTOLL_URL is localhost.
# AGENTTOLL_RECIPIENT=0xYourReceivingWalletAddress

# Finite per-client/session USDC budget, maximum six decimal places.
# These defaults are already enforced when the settings are absent.
# AGENTTOLL_BUDGET_USDC=1
# Optional lower per-call ceiling; cannot raise registered endpoint prices.
# AGENTTOLL_MAX_PER_CALL_USDC=0.008
# Total quote/sign/retry/body deadline; default 30000 (allowed 1–300000).
# AGENTTOLL_TIMEOUT_MS=30000
