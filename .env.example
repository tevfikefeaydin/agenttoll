# Wallet address that receives USDC payments (your Base account)
ADDRESS=0xYourBaseAddress

# Network: base-sepolia (testnet, free facilitator) or base (mainnet, requires CDP facilitator)
NETWORK=base-sepolia

# Facilitator that verifies & settles x402 payments
# Testnet: https://x402.org/facilitator  |  Mainnet: use @coinbase/x402 with CDP keys
FACILITATOR_URL=https://x402.org/facilitator

PORT=4021

# Only needed for examples/agent-client.ts (a funded test wallet for the paying agent)
# AGENT_PRIVATE_KEY=0x...

# Optional. Blockscout works fine with no key; setting this gets a dedicated
# 10 req/s quota instead of sharing the anonymous pool, as a retry after the
# free path fails.
# BLOCKSCOUT_API_KEY=proapi_...
