{
  "name": "agenttoll",
  "version": "0.1.0",
  "description": "Pay-per-call APIs for AI agents - HTTP 402 micropayments in USDC, settled on Base via x402",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "node --import tsx scripts/sync-shared.mjs && tsc && npm run build:web",
    "build:web": "esbuild web/demo.ts --bundle --format=iife --target=es2020 --minify --outfile=public/demo.js",
    "start": "node dist/index.js",
    "example:client": "tsx examples/agent-client.ts",
    "example:langchain": "tsx examples/langchain-tool.ts",
    "brand:png": "node brand/export-png.mjs",
    "test": "node scripts/test.mjs",
    "typecheck": "npm run typecheck:api && npm run typecheck:web && npm run typecheck:mcp && npm run typecheck:tests",
    "typecheck:api": "tsc --noEmit",
    "typecheck:web": "tsc -p web/tsconfig.json",
    "typecheck:mcp": "npm --prefix mcp run typecheck",
    "generate": "node --import tsx scripts/sync-shared.mjs && node --import tsx scripts/openapi-examples.mjs",
    "check:generated": "node --import tsx scripts/sync-shared.mjs --check && node --import tsx scripts/openapi-examples.mjs --check && node --import tsx scripts/consistency.mjs && node scripts/check-web.mjs",
    "typecheck:tests": "tsc -p tsconfig.tests.json",
    "smoke:mcp": "node scripts/mcp-package-smoke.mjs"
  },
  "keywords": [
    "x402",
    "base",
    "ai-agents",
    "micropayments",
    "usdc",
    "http-402",
    "agentic-payments"
  ],
  "license": "MIT",
  "dependencies": {
    "@coinbase/x402": "^2.1.0",
    "@x402/core": "^2.21.0",
    "@x402/evm": "^2.21.0",
    "@x402/express": "^2.21.0",
    "@x402/extensions": "^2.21.0",
    "@x402/fetch": "^2.21.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "viem": "^2.55.10"
  },
  "devDependencies": {
    "@langchain/core": "^1.2.9",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "sharp": "^0.35.3",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "esbuild": "^0.28.1",
    "@modelcontextprotocol/sdk": "^1.30.0"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "@coinbase/cdp-sdk": {
      "axios": "^1.20.0"
    }
  }
}
