[Unit]
Description=AgentToll private retained usage collector
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/agenttoll/usage/usage_collect.py
WorkingDirectory=/opt/agenttoll/usage/app
TimeoutStartSec=300
User=root
UMask=0077
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
StateDirectory=agenttoll-usage
StateDirectoryMode=0700
ReadWritePaths=/var/lib/agenttoll-usage
MemoryMax=1536M
