# Copy to .env.production on the server and populate from Vercel Production.
# Do not use the local development .env: it is configured for Base Sepolia.
# The hosted API needs the receiving PUBLIC address, never a wallet private key.
ADDRESS=0xe55359021a6a22d8385b827405991c56075f56f8
NETWORK=base
FACILITATOR_URL=https://x402.org/facilitator
CDP_API_KEY_ID=replace-with-existing-production-key-id
CDP_API_KEY_SECRET=replace-with-existing-production-key-secret
REQUEST_TIMEOUT_MS=25000
# BLOCKSCOUT_API_KEY=existing-production-key-if-configured
