[Unit]
Description=Deploy CI-verified AgentToll main releases
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/agenttoll/deployer/autodeploy.py
TimeoutStartSec=25min
UMask=0077
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
# Add the configured proxy snippet directory with a host-local systemd drop-in.
# See AUTODEPLOY.md before installing this template.
ReadWritePaths=/opt/agenttoll
