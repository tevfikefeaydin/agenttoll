[Unit]
Description=Deploy CI-verified AgentToll main releases
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/agenttoll/deployer/autodeploy.py
TimeoutStartSec=25min
UMask=0077
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/agenttoll /var/lib/docker/volumes/altyapi_caddy_data/_data/agenttoll
