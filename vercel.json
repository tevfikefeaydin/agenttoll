{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "comment": "One service, one origin. The same deployment answers on three hosts, and directories that key off the URL counted us three times - fifteen records under the vercel host, one under www, eighteen under the apex, all describing the same twenty-one resources. Machine-facing surfaces now redirect permanently to the apex so a crawler sees one canonical origin. The HTML site is deliberately left reachable on the vercel host: the operator's corporate network intermittently intercepts .app domains, and that host is the fallback for reading the site at all.",
  "redirects": [
    { "source": "/:path*", "has": [{ "type": "host", "value": "www.agenttoll.app" }], "destination": "https://agenttoll.app/:path*", "permanent": true },
    { "source": "/api/:path*", "has": [{ "type": "host", "value": "agenttoll-pi.vercel.app" }], "destination": "https://agenttoll.app/api/:path*", "permanent": true },
    { "source": "/.well-known/:path*", "has": [{ "type": "host", "value": "agenttoll-pi.vercel.app" }], "destination": "https://agenttoll.app/.well-known/:path*", "permanent": true },
    { "source": "/openapi.json", "has": [{ "type": "host", "value": "agenttoll-pi.vercel.app" }], "destination": "https://agenttoll.app/openapi.json", "permanent": true },
    { "source": "/llms.txt", "has": [{ "type": "host", "value": "agenttoll-pi.vercel.app" }], "destination": "https://agenttoll.app/llms.txt", "permanent": true }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/favicon.ico", "destination": "/icon.png" },
    { "source": "/terms", "destination": "/terms.html" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/legal", "destination": "/terms.html" },
    { "source": "/legal-notice", "destination": "/terms.html" },
    { "source": "/imprint", "destination": "/terms.html" },
    { "source": "/privacy-policy", "destination": "/privacy.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Content-Security-Policy", "value": "default-src 'none'; style-src 'unsafe-inline'; img-src 'self' data:; media-src 'self'; script-src 'self'; connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'" }
      ]
    }
  ]
}
